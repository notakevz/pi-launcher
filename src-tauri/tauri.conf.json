{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pi Launcher",
  "version": "0.1.1",
  "identifier": "local.pi.launcher",
  "build": {
    "beforeDevCommand": { "script": "npm run build:ui", "wait": true },
    "beforeBuildCommand": "npm run build:ui",
    "frontendDist": "../.build/ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'none'; img-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "nsis/LICENSE-TAURI-MIT": "LICENSE-TAURI-MIT",
      "../.build/ui/THIRD_PARTY_FRONTEND_LICENSES.txt": "THIRD_PARTY_FRONTEND_LICENSES.txt"
    },
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "publisher": "Pi Launcher",
    "copyright": "MIT License",
    "category": "DeveloperTool",
    "shortDescription": "Pi Web desktop launcher",
    "longDescription": "Starts and manages a local Pi Web backend and shows it in a standalone window.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./nsis/hooks.nsh",
        "template": "./nsis/installer.nsi"
      }
    }
  }
}
