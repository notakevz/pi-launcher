{
  "name": "pi-launcher-tauri",
  "version": "0.1.1",
  "private": true,
  "description": "Windows Pi Web desktop launcher using Tauri v2 and WebView2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/notakevz/pi-launcher.git"
  },
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "tauri": "tauri",
    "start": "tauri dev",
    "dev": "tauri dev",
    "build": "npm run check:version && tauri build --ci --no-sign --bundles nsis -- --locked",
    "build:ui": "vite build",
    "preview:ui": "vite preview",
    "test": "npm run test:tools && npm run test:ui",
    "test:tools": "node --test scripts/test-release-unit.js scripts/test-backend-tools.js scripts/test-version-unit.js scripts/test-stage-unit.js",
    "test:ui": "vitest run",
    "test:ui:layout": "playwright test",
    "check:syntax": "node scripts/check-syntax.js",
    "check:version": "node scripts/check-version.js",
    "stage:installer": "node scripts/stage-installer.js",
    "build:source": "node scripts/build-source.js",
    "backend:verify": "node scripts/verify-backend.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tauri-apps/cli": "2.12.4",
    "@vitejs/plugin-vue": "^6.0.10",
    "jsdom": "^26.1.0",
    "vite": "^7.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@primeuix/themes": "^1.2.5",
    "primevue": "^4.5.5",
    "vue": "^3.5.45"
  }
}
